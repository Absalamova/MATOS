# MATOS sozlamalari.
# Kompyuterda ishlab chiqish uchun .env SHART EMAS — `npm run dev` hammasini standart qiymatlar bilan ishga tushiradi.
# Serverda: shu faylni server/.env nomi bilan nusxalang va qiymatlarni o‘zingiznikiga almashtiring.

# ───────────── API server ─────────────
NODE_ENV=production
PORT=8080
# nginx/Caddy orqasida: 127.0.0.1; Docker ichida: 0.0.0.0
HOST=127.0.0.1
# API ning tashqi manzili (yuklangan suratlar havolasi shundan yasaladi)
PUBLIC_URL=https://api.matos.uz
# Telegram xabaridagi havolalar uchun
ADMIN_URL=https://admin.matos.uz
# API ga murojaat qila oladigan saytlar (vergul bilan)
CORS_ORIGINS=https://matos.uz,https://www.matos.uz,https://admin.matos.uz
# nginx/Caddy orqasida 1 — mijozning haqiqiy IP manzili olinadi (limitlar uchun)
TRUST_PROXY=1
# Baza (SQLite) va yuklangan suratlar shu papkada. Zaxira nusxa: npm run db:backup
DATA_DIR=server/data

# Birinchi ishga tushishda yaratiladigan ega (owner) hisobi. Parol kamida 10 belgi.
ADMIN_EMAIL=siz@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Yangi buyurtma kelganda Telegram xabari (ixtiyoriy):
# 1) @BotFather da bot yarating → token;  2) botni guruhga qo‘shing;  3) guruh chat_id sini kiriting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sessiya muddatlari
SESSION_DAYS_USER=30
SESSION_HOURS_ADMIN=12

# ───────────── Sayt va admin (build vaqtida) ─────────────
# Standart: production → https://api.matos.uz, https://admin.matos.uz, https://matos.uz/
# Domenlaringiz boshqacha bo‘lsa, ularni .env.production fayliga yozing:
# VITE_API_URL=https://api.matos.uz
# VITE_ADMIN_URL=https://admin.matos.uz
# VITE_STORE_URL=https://matos.uz/
